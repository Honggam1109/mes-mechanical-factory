# Cấu hình tuỳ chọn. Không cần file này để chạy thử: mọi biến đều có giá trị mặc định.
# Ứng dụng KHÔNG tự đọc file .env. Cách dùng: sao chép thành .env rồi chạy
#   node --env-file=.env node_modules/vite/bin/vite.js     (chế độ phát triển)
#   node --env-file=.env server/index.mjs                  (sau khi build)

# Tài khoản quản trị, chỉ có tác dụng khi tạo database lần đầu.
# Mật khẩu 8-50 ký tự, có chữ hoa, chữ thường, chữ số và không có khoảng trắng.
# Bỏ trống: hệ thống sinh mật khẩu ngẫu nhiên và in ra terminal một lần.
MES_ADMIN_USERNAME=admin
MES_ADMIN_PASSWORD=

# Đường dẫn file SQLite
MES_DB=server/data/mes.sqlite

# Cổng của chế độ phát triển
PORT=8443

# Địa chỉ và cổng của bản build (npm start)
MES_HOST=127.0.0.1
MES_PORT=3001
